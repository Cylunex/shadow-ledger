LEDGER_ENV=development
LEDGER_DATABASE_URL_FILE=/run/secrets/ledger-database-url
LEDGER_OIDC_CLIENT_SECRET_FILE=/run/secrets/ledger-oidc-client-secret
LEDGER_OIDC_ISSUER=https://identity.example.com
LEDGER_OIDC_CLIENT_ID=shadow-ledger
LEDGER_OIDC_CALLBACKS=["https://ledger.example.com/auth/callback","https://ledger-lan.example.com/auth/callback"]
LEDGER_ALLOWED_ORIGINS=["https://ledger.example.com","https://ledger-lan.example.com"]
LEDGER_REQUIRED_GROUP=ledger-users
LEDGER_SESSION_SECRET_FILE=/run/secrets/ledger-session-secret
LEDGER_DEFAULT_CURRENCY=CNY
LEDGER_DEFAULT_TIMEZONE=Asia/Shanghai
LEDGER_ASSET_BASE_URL=https://asset.example.com
LEDGER_ASSET_SERVICE_TOKEN_FILE=/run/secrets/ledger-asset-service-token
LEDGER_CAPTURE_PROVIDER_URL=https://capture.example.com/api/parse
LEDGER_CAPTURE_PROVIDER_KEY_FILE=/run/secrets/ledger-capture-provider-key
LEDGER_PLATFORM_RESOLVER_URL=https://platform.example.com/api/resolve
LEDGER_SERVICE_TOKEN_HASHES_FILE=/run/secrets/ledger-service-token-hashes
LEDGER_AGENT_REGISTRY_PATH=/run/secrets/ledger-agents/registry.yaml
LEDGER_AGENT_SECRETS_DIR=/run/secrets/ledger-agents
LEDGER_INTAKE_DIRECTORY=/var/lib/shadow-ledger/intake
LEDGER_INTAKE_OWNER_ID_FILE=/run/secrets/ledger-intake-owner-id
LEDGER_MCP_OWNER_ID_FILE=/run/secrets/ledger-mcp-owner-id
LEDGER_MCP_ALLOW_DRAFTS=false
LEDGER_TRUSTED_PROXIES=["127.0.0.1"]
LEDGER_DEV_AUTH=false
